# Copy to .env before the first `docker compose up`. Every value has a default in
# docker-compose.yml, so an empty file is legal; override only what you need.
# The host ports below are the ones the six services already use in their .env.

# Postgres (auth/cart/catalog/order/search all share this database locally)
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom-dev-only
POSTGRES_DB=ecom
POSTGRES_PORT=5433

REDIS_PORT=6379
MONGO_PORT=27018
KAFKA_PORT=9092

# LocalStack SQS. The credentials are placeholders: LocalStack accepts anything.
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAX_RECEIVE_COUNT=5

# Mailpit: SMTP in, web UI out.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
